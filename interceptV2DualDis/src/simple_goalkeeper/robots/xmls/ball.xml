<mujoco model="ball">
  <worldbody>
    <!-- Soccer ball: size 5, radius=0.10m (diameter 20cm), mass=0.42kg -->
    <!-- group=1: keeps ball out of terrain raycasts (which only scan group 0) -->
    <body name="ball" pos="0 0 0.10">
      <!-- damping=0.003: viscous rolling deceleration (~1.8 m/s² at 2 m/s).
           condim=3 makes torsional/rolling friction values inactive, so joint
           damping is the only way to decelerate a pure-rolling ball. -->
      <joint type="free" name="ball_freejoint" damping="0.0005"/>
      <inertial mass="0.42" pos="0 0 0" diaginertia="0.00168 0.00168 0.00168"/>
      <!-- friction = [slide, torsional, rolling] — matches Imitationlearningbooster exactly.
           condim=3 (default, NOT 6): only normal + 2 tangential constraints are active.
           condim=6 would add torsional+rolling torque constraints; combined with
           solref[0]=0.002 < sim timestep=0.005 those extra constraints go numerically
           unstable and inject energy (bouncing higher each bounce). Imitationlearningbooster
           never sets condim on the ball, defaulting to 3, which is stable.
           solref=[0.002, 0.0001]: very stiff + near-zero damping = elastic bounce.
           solimp=[0.0001, 0.001, 0.0001, 0.5, 2.0]: soft impedance ramp.
           margin=0.001, gap=0.0001: prevent penetration jitter. -->
      <geom name="ball_geom"
            type="sphere"
            size="0.10"
            group="1"
            rgba="1 0.9 0 1"
            friction="0.4 0.005 0.0001"
            solref="0.002 0.0001"
            solimp="0.0001 0.001 0.0001 0.5 2"
            margin="0.001"
            gap="0.0001"
            contype="1"
            conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
